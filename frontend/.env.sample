VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://meshinfo:9000

VITE_MAP_PROVIDER=osm          # osm | mapbox
VITE_MAPBOX_STYLE=mapbox/streets-v12

# Required when provider=mapbox (or provider=auto + map provider is mapbox)
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_GEOCODER_COUNTRY=US      # optional
VITE_MAPBOX_GEOCODER_LANGUAGE=en     # optional
# auto | nominatim | mapbox
VITE_GEOCODER_PROVIDER=auto

VITE_NOMINATIM_EMAIL=
