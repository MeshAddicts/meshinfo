# Build artifacts + repo metadata that don't belong in the image.
.git
.github
.venv
.vscode
.pytest_cache
# Globstar form so the rule applies at any depth — bare `__pycache__` only
# matches the top level under classic builder; BuildKit treats it recursively
# but pin explicitly to avoid drift.
**/__pycache__
**/*.pyc

# Local-only state.
caddy
output
postgres
config.toml
mosquitto/data

# Docs — don't ship in the backend image (the README/etc. live in the repo).
*.md
docs

# Smoke tests aren't useful inside the container.
tests

# Host node_modules would clobber the container install and drop .bin shims.
frontend/node_modules
# Regenerated inside the wasm-build stage.
frontend/wasm/itm/vendor
frontend/wasm/itm/dist
frontend/wasm/itm/fixtures
