{
	debug
}

http://localhost {
	encode gzip

	# Tile API (land-cover / canopy / buildings)
	handle_path /api/tiles/* {
		rewrite * /tiles{uri}
		reverse_proxy meshinfo:9000
	}
	handle /tiles/* {
		reverse_proxy meshinfo:9000
	}

	handle_path /api/* {
		reverse_proxy meshinfo:9000
	}
	handle /next {
		respond "Gone" 410
	}
	handle /next/* {
		respond "Gone" 410
	}
	handle {
		reverse_proxy frontend:5173
	}
}