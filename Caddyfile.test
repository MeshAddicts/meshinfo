# HTTP-only routing for the test-VM stack (docker-compose.test.yml): same
# path split as production (API + tiles → meshinfo, everything else → SPA)
# without TLS/domain requirements or the Cloudflare plugin build.
:80 {
	encode gzip

	@backend path /v1/* /api/* /tiles/*
	handle @backend {
		reverse_proxy meshinfo:9000
	}

	handle {
		reverse_proxy frontend:80
	}
}
