# Copy this file to `.env` and edit. Docker Compose loads `.env` automatically.

# PostgreSQL memory tuning. Defaults below suit a small host; size up to your
# host RAM — see the table in POSTGRES.md.
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_EFFECTIVE_CACHE_SIZE=1GB

# Compressed cold storage for closed months (ZFS.md) — uncomment ONE layout.
# Once COMPOSE_FILE names the files, docker-compose.override.yml is no longer
# loaded automatically: if you use one, add it to the list before the overlay
# (e.g. docker-compose.yml:docker-compose.override.yml:docker-compose.cold.yml).
# Cold-only: the cluster stays on its Docker volume; the directory on the
# btrfs filesystem or ZFS dataset that holds the meshinfo_cold tablespace is
# bound by docker-compose.cold.yml (no default on purpose).
# `sudo scripts/setup-cold-storage.sh` prepares that directory and writes
# these two lines for you.
#COMPOSE_FILE=docker-compose.yml:docker-compose.cold.yml
#MESHINFO_PGCOLD_DIR=/srv/meshinfo/pgcold
# Full ZFS: the two dataset mountpoints, bound by docker-compose.zfs.yml.
#COMPOSE_FILE=docker-compose.yml:docker-compose.zfs.yml
#MESHINFO_ZFS_HOT=/tank/meshinfo/pgdata
#MESHINFO_ZFS_COLD=/tank/meshinfo/pgcold
