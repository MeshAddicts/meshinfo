{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["every weekend"],
  "platformAutomerge": false,
  "automergeSchedule": ["at any time"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "python-deps"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend-deps",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker-images"
    },
    {
      "matchManagers": ["dockerfile", "nvm", "asdf"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "node-version",
      "automerge": true
    },
    {
      "description": "LTS-only Node (revisit when the LTS line after 26 is announced)",
      "matchPackageNames": ["node"],
      "allowedVersions": "/^(24|26)(\\.|$)/"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "PostgreSQL majors are deliberate: the on-disk format changes and every install has to migrate. The bump waits in the Dependency Dashboard; read POSTGRES.md, \"Before bumping the PostgreSQL major\", before ticking it. Its own group, so that no other image update waits with it.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "groupName": "postgresql",
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the CI frontend job's Node major via the node-version datasource",
      "fileMatch": ["^\\.github/workflows/tests\\.yml$"],
      "matchStrings": ["node-version:\\s*[\"']?(?<currentValue>[\\d.]+)[\"']?"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
